    {
      "id": "c822bf86465d",
      "slug": "khu-cong-nghiep-yen-my-viglacera-tinh-hung-yen",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-yen-my-viglacera-tinh-hung-yen/",
      "title": "Khu Công nghiệp Yên Mỹ (Viglacera) tỉnh Hưng Yên",
      "type": "khu-cong-nghiep",
      "date": "2025-12-24T10:12:59+07:00",
      "location": {
        "province": "lộ 376 phía Tây Nam",
        "district": "",
        "address": "Khu Công nghiệp Yên Mỹ Hưng Yên nằm trên Quốc lộ 39A phía Tây, Tỉnh lộ 376 phía Tây Nam, đồng thời nằm giữa Quốc lộ 5A và cao tốc Hà Nội – Hải Phòng. Ngoài thừa hưởng những thuận lợi về vị trí địa lý của tỉnh Hưng Yên, KCN Yên Mỹ còn có mạng lưới kết nối giao thông đồng bộ, cả đường bộ, đường sắt, đường sông, đường biển, đường hàng không.",
        "old_address": ""
      },
      "details": {
