    {
      "id": "04763612560f",
      "slug": "khu-cong-nghiep-noi-bai-thanh-pho-ha-noi",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-noi-bai-thanh-pho-ha-noi/",
      "title": "Khu Công nghiệp Nội Bài thành phố Hà Nội",
      "type": "khu-cong-nghiep",
      "date": null,
