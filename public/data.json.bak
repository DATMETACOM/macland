    {
      "id": "03f71bc02a60",
      "slug": "khu-cong-nghiep-chau-minh-bac-ly-huong-lam",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-chau-minh-bac-ly-huong-lam/",
      "title": "Khu Công nghiệp Châu Minh – Bắc Lý – Hương Lâm tỉnh Bắc Giang",
      "type": "khu-cong-nghiep",
