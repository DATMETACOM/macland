    {
      "id": "77ac53ec732a",
      "slug": "khu-cong-nghiep-bim-son-a-tinh-thanh-hoa",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-bim-son-a-tinh-thanh-hoa/",
      "title": "Khu Công nghiệp Bỉm Sơn A tỉnh Thanh Hóa – ROX iPark",
      "type": "khu-cong-nghiep",
      "date": "2025-09-09T11:43:55+07:00",
      "location": {
        "province": "",
        "district": "",
        "address": "Khu Công nghiệp Bỉm Sơn A tỉnh Thanh Hóa – ROX iPark",
        "old_address": ""
      },
      "details": {
        "area": "160 ha",
        "area_unit": "ha",
        "occupancy_rate": "60%",
        "operating_period": "",
