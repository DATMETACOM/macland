    {
      "id": "a365d477cad8",
      "slug": "khu-cong-nghiep-phu-long-tinh-ninh-binh",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-phu-long-tinh-ninh-binh/",
      "title": "Khu Công nghiệp Phú Long tỉnh Ninh Bình",
      "type": "khu-cong-nghiep",
      "date": "2025-05-10T11:06:13+07:00",
      "location": {
        "province": "",
        "district": "",
