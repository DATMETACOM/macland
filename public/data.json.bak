      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-yen-binh-2/",
      "title": "Khu Công nghiệp Yên Bình 2 tỉnh Thái Nguyên",
      "type": "khu-cong-nghiep",
      "date": "2025-10-15T11:00:08+07:00",
      "location": {
        "province": "Bắc Ninh",
        "district": "Yên Phong",
        "address": "Xã Tam Giang, Huyện Yên Phong, Tỉnh Bắc Ninh",
        "old_address": ""
      },
      "details": {
        "area": "299.07 ha",
        "area_unit": "ha",
        "occupancy_rate": "Đang cập nhật",
        "operating_period": "",
