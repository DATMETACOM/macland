    {
      "id": "3f06c2fa62c6",
      "slug": "khu-cong-nghiep-que-vo-ii-giai-doan-2",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-que-vo-ii-giai-doan-2/",
      "title": "Khu Công nghiệp Quế Võ II – Giai đoạn 2 tỉnh Bắc Ninh",
      "type": "khu-cong-nghiep",
      "date": "2025-12-24T11:46:07+07:00",
      "location": {
        "province": "Thái Bình",
        "district": "Hưng Hà",
        "address": "Thị Trấn Hưng Nhân & xã Tân Hòa, Huyện Hưng Hà, Tỉnh Thái Bình",
        "old_address": ""
      },
      "details": {
        "area": "277 ha",
        "area_unit": "ha",
        "occupancy_rate": "Đang cập nhật",
