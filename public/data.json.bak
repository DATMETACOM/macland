      "url": "https://www.macland.vn/bds-cong-nghiep/cum-cong-nghiep-kim-thai/",
      "title": "Cụm Công nghiệp Kim Thái tỉnh Nam Định",
      "type": "cum-cong-nghiep",
      "date": "2026-01-06T11:04:57+07:00",
      "location": {
        "province": "Bắc Ninh",
        "district": "Yên Phong",
        "address": "Xã Tam Giang, Huyện Yên Phong, Tỉnh Bắc Ninh",
        "old_address": ""
      },
      "details": {
        "area": "69.04 ha",
        "area_unit": "ha",
        "occupancy_rate": "85%",
        "operating_period": "",
