    {
      "id": "6f23d2967a8e",
      "slug": "khu-cong-nghiep-minh-duc-thuong-lan-ngoc-thien",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-minh-duc-thuong-lan-ngoc-thien/",
      "title": "Khu Công nghiệp Minh Đức – Thượng Lan – Ngọc Thiện tỉnh Bắc Giang",
      "type": "khu-cong-nghiep",
