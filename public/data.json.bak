    {
      "id": "0f4c07ffcf5c",
      "slug": "khu-cong-nghiep-sach-soc-son-thanh-pho-ha-noi",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-sach-soc-son-thanh-pho-ha-noi/",
      "title": "Khu Công nghiệp sạch Sóc Sơn thành phố Hà Nội",
      "type": "khu-cong-nghiep",
      "date": "2025-07-10T15:27:26+07:00",
      "location": {
        "province": "Hà Nội",
        "district": "",
        "address": "xã Tân Dân, xã Minh Trí, huyện Sóc Sơn, Thành phố Hà Nội",
        "old_address": ""
      },
      "details": {
        "area": "323.9 ha",
        "area_unit": "ha",
        "occupancy_rate": "Đang cập nhật",
        "operating_period": "",
        "investment_sectors": [
          "",
          "Miễn thuế TNDN trong 2 năm đầu, giảm 50% trong 4 năm tiếp theo."
        ]
      },
      "pricing": {
        "type": "tu-usd-m2",
        "price": "220.0USD/m²",
        "price_min": 220.0,
        "price_unit": "USD/m²"
      },
      "legal": {
        "status": "Đầy đủ giấy tờ",
