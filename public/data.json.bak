    {
      "id": "9af280aee17c",
      "slug": "cum-cong-nghiep-son-cam-2",
      "url": "https://www.macland.vn/bds-cong-nghiep/cum-cong-nghiep-son-cam-2/",
      "title": "Cụm Công nghiệp Sơn Cẩm 2 tỉnh Thái Nguyên",
      "type": "cum-cong-nghiep",
      "date": "2025-12-10T16:43:50+07:00",
      "location": {
        "province": "Cần Thơ",
        "district": "",
        "address": "bao gồm: KCN Trà Nóc 1 (135 ha); KCN Trà Nóc 2 (157 ha, nằm liền kề KCN Trà Nóc 1); KCN Hưng Phú 1 (262 ha); KCN Hưng Phú 2A (134 ha); KCN Hưng Phú 2B (62 ha); KCN Thốt Nốt (600 ha; KCN Ô Môn có diện tích 600 ha; KCN Bắc Ô Môn có diện tích 400 ha. Khu công nghiệp Hưng Phú 1 được thành lập năm 2005 theo QĐ số 2287/QĐ-UB ngày 5/7/2005 của UBND Thành phố Cần Thơ, với tổng diện tích 262 ha, nằm ở phường Tân Phú,quận Cái Răng, thành phố Cần Thơ.",
        "old_address": ""
      },
      "details": {
        "area": "30 ha",
        "area_unit": "ha",
        "occupancy_rate": "Đang cập nhật",
        "operating_period": "",
        "investment_sectors": [
          "Dệt may và phụ kiện, da giày; công nghiệp hỗ trợ; điện tử; vật liệu xây dựng; chế biến nông, lâm sản; thức ăn chăn nuoi; công nghiệp hóa dược; dịch vụ công cộng; đồ mỹ nghệ; nội thất công trình và gia đình; các ngành nghề công nghiệp, tiểu thủ công nghiệp khác…",
          "",
