    {
      "id": "7b3a7a0ae212",
      "slug": "khu-cong-nghiep-phuc-long-tinh-long-an",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-phuc-long-tinh-long-an/",
      "title": "Khu Công nghiệp Phúc Long tỉnh Long An",
      "type": "khu-cong-nghiep",
      "date": null,
      "location": {
        "province": "Thái Bình",
        "district": "Hưng Hà",
