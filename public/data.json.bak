    {
      "id": "8672404aa948",
      "slug": "khu-cong-nghiep-bac-chu-lai-tinh-quang-nam",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-bac-chu-lai-tinh-quang-nam/",
      "title": "Khu Công nghiệp Bắc Chu Lai tỉnh Quảng Nam",
      "type": "khu-cong-nghiep",
      "date": "2025-06-20T10:14:04+07:00",
      "location": {
        "province": "Qua",
        "district": "",
        "address": ": Tỉnh Quảng Nam có nguồn lao động dồi dào, chất lượng nguồn lao động đang được cải thiện đáng kể. Số người trong độ tuổi lao động khoảng hơn 800.000 người, chiếm 54% dân số của tỉnh. Mức lương bình quân của người lao động: 4.000.000 – 6.000.000 VND/tháng.",
