    {
      "id": "f6c61425b4d6",
      "slug": "cho-thue-kho-xuong-lam-duoc-epe-co-dtm-bac-ninh",
      "url": "https://www.macland.vn/bds-cong-nghiep/cho-thue-kho-xuong-lam-duoc-epe-co-dtm-bac-ninh/",
      "title": "Cho thuê kho xưởng làm được EPE có DTM diện tích 5000m2 – 10.000m2 tại Bắc Ninh",
      "type": "nha-xuong",
      "date": null,
      "location": {
        "province": "cũng nằm trong Vùng kinh tế trọng điểm Bắc bộ",
        "district": "",
        "address": "là một tỉnh ở Việt Nam. Đây là tỉnh có diện tích nhỏ nhất đất nước, với vị trí nằm trong Vùng thủ đô Hà Nội, thuộc vùng Đồng bằng sông Hồng. Tỉnh cũng nằm trong Vùng kinh tế trọng điểm Bắc bộ, Việt Nam.",
        "old_address": ""
      },
      "details": {
