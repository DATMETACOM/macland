    {
      "id": "676db4b631ff",
      "slug": "cum-cong-nghiep-dong-tho-tinh-bac-ninh",
      "url": "https://www.macland.vn/bds-cong-nghiep/cum-cong-nghiep-dong-tho-tinh-bac-ninh/",
      "title": "Cụm Công nghiệp Đông Thọ tỉnh Bắc Ninh",
      "type": "cum-cong-nghiep",
      "date": "2025-07-01T14:13:12+07:00",
      "location": {
        "province": "Bắc Ninh",
        "district": "Yên Phong",
        "address": "Xã Tam Giang, Huyện Yên Phong, Tỉnh Bắc Ninh",
        "old_address": ""
      },
      "details": {
        "area": "50 ha",
        "area_unit": "ha",
        "occupancy_rate": "",
        "operating_period": "",
