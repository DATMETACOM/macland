    {
      "id": "355f01ce5211",
      "slug": "khu-cong-nghiep-ly-thuong-kiet-hung-yen",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-ly-thuong-kiet-hung-yen/",
      "title": "Khu Công nghiệp Lý Thường Kiệt tỉnh Hưng Yên",
      "type": "khu-cong-nghiep",
      "date": "2025-11-12T17:11:52+07:00",
      "location": {
        "province": "",
        "district": "",
        "address": "Khu Công nghiệp Lý Thường Kiệt tỉnh Hưng Yên",
        "old_address": ""
      },
      "details": {
