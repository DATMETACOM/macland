    {
      "id": "dfa1ce0fad0b",
      "slug": "khu-cong-nghiep-thuan-thanh-iii-phan-khu-b-tinh-bac-ninh",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-thuan-thanh-iii-phan-khu-b-tinh-bac-ninh/",
      "title": "Khu công nghiệp Thuận Thành III phân khu B tỉnh Bắc Ninh",
      "type": "khu-cong-nghiep",
      "date": "2025-11-19T15:32:33+07:00",
      "location": {
        "province": "",
