    {
      "id": "15620b9f2b7c",
      "slug": "khu-cong-nghiep-thuan-dao-tinh-long-an",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-thuan-dao-tinh-long-an/",
      "title": "Khu Công nghiệp Thuận Đạo tỉnh Long An",
      "type": "khu-cong-nghiep",
      "date": "2025-04-22T15:25:35+07:00",
      "location": {
        "province": "Long An có 02 trường Đại học",
        "district": "Bến Lức",
        "address": ": Dân số toàn tỉnh Long An khoảng 2.003.000 người. Trong đó, số lượng lao động đang làm việc tại các khu cụm công nghiệp vào khoảng 200.000 người. Tỉnh Long An có 02 trường Đại học, 03 trường Cao đẳng nghề; 06 trường trung cấp; 02 trường trung cấp nghề; 7 trung tâm dạy nghề; 14 Trung tâm GD KTTH – hướng nghiệp; 06 TT giới thiệu việc làm; 35 trường PHTH. Huyện Bến Lức & Cần Đước thuộc vùng II – Mức lương cơ bản là 4.160.000 đồng/tháng/người (từ 01/07/2022).",
        "old_address": ""
      },
      "details": {
        "area": "815 ha",
        "area_unit": "ha",
        "occupancy_rate": "90%",
        "operating_period": "",
