    {
      "id": "dfee7f7c2b9a",
      "slug": "khu-cong-nghiep-song-cong-ii-gd2",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-song-cong-ii-gd2/",
      "title": "Khu Công nghiệp Sông Công II giai đoạn 2 tỉnh Thái Nguyên",
      "type": "khu-cong-nghiep",
      "date": null,
