    {
      "id": "65ca6b9e5875",
      "slug": "khu-cong-nghiep-thang-long-2-tinh-hung-yen",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-thang-long-2-tinh-hung-yen/",
      "title": "Khu Công nghiệp Thăng Long 2 tỉnh Hưng Yên",
      "type": "khu-cong-nghiep",
      "date": "2025-10-01T10:47:47+07:00",
      "location": {
        "province": "Hưng Yên",
        "district": "",
        "address": "Khu Công Nghiệp Thăng Long 2 Tỉnh Hưng Yên",
        "old_address": ""
      },
      "details": {
        "area": "ha",
        "area_unit": "ha",
        "occupancy_rate": "",
        "operating_period": "",
