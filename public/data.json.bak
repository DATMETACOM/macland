          "Công ty Cổ phần khu công nghiệp Đồng Tâm",
          "Miễn thuế TNDN 02 năm đầu; Giảm 50% cho 04 năm tiếp theo. Thuế suất áp dụng 20%."
        ]
      },
      "pricing": {
        "type": "thoa-thuan",
        "price": null,
        "price_min": null,
