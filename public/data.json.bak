    {
      "id": "e1733f03c97e",
      "slug": "khu-cong-nghiep-yen-phong-ii-a-tinh-bac-ninh",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-yen-phong-ii-a-tinh-bac-ninh/",
      "title": "Khu Công nghiệp Yên Phong II-A tỉnh Bắc Ninh",
