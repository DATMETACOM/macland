    {
      "id": "6169c198149c",
      "slug": "khu-cong-nghiep-ngoc-lac-tinh-thanh-hoa",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-ngoc-lac-tinh-thanh-hoa/",
      "title": "Khu Công nghiệp Ngọc Lặc tỉnh Thanh Hóa",
      "type": "khu-cong-nghiep",
      "date": null,
      "location": {
        "province": "Quảng Ninh",
        "district": "Quảng Yên",
        "address": "Thị xã Quảng Yên, Tỉnh Quảng Ninh",
