    {
      "id": "79b6a0fd9d02",
      "slug": "khu-cong-nghiep-luong-dien-ngoc-lien-tinh-hai-duong-2",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-luong-dien-ngoc-lien-tinh-hai-duong-2/",
      "title": "Khu Công nghiệp An Phát 5 (Lương Điền – Ngọc Liên) tỉnh Hải Dương",
      "type": "khu-cong-nghiep",
