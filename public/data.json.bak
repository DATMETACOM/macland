      "url": "https://www.macland.vn/bds-cong-nghiep/nha-xuong-kcn-cam-khe-phu-tho-38/",
      "title": "Cho thuê 3000 – 9000m2 nhà xưởng tiêu chuẩn KCN Cẩm Khê tỉnh Phú Thọ",
      "type": "nha-xuong",
      "date": null,
      "location": {
        "province": "Hưng Yên",
        "district": "Yên Mỹ",
        "address": "Thị trấn Yên Mỹ, Huyện Yên Mỹ, Tỉnh Hưng Yên",
        "old_address": ""
      },
      "details": {
        "area": "10000 m²",
        "area_unit": "m²",
        "occupancy_rate": "Đang cập nhật",
        "operating_period": "",
        "investment_sectors": [
          "Mục đích sử dụng của Khu công nghiệp Liên Hà Thái:Kho xưởng lắp ráp chế tạo máy, tự động hóa, công nghiệp ô tô, công nghiệp phụ trợ, vật liệu xây dựng, dịch vụ công nghiệp, công nghiệp chế biến, sản xuất hàng tiêu dùng….",
          "Mục đích sử dụng:Nhà máy sản xuất đa ngành nghề, xây dựng xưởng cho thuê…",
          "Khu công nghiệp Hanssip hỗ trợ Nam Hà Nội là tổ hợp công nghiệp – đô thị và phát triển theo hướng thành phố công nghiệp và đô thị thông minh với đầy đủ tiện ích phục vụ cho nhu cầu sản xuất và cuộc sống thường nhật.",
          "Ngành nghề thu hút đầu tư: Sản xuất, lắp ráp thiết bị, linh kiện truyền dữ liệu, điện thoại di động, máy vi tính và các thiết bị ngoại vi; sản xuất phần mềm và nội dung số; sản xuất lắp ráp linh kiện và sản phẩm điện, điện tử, điện lạnh, quang học, viễn thông, ô tô, xe máy, và các phương tiện, máy móc, thiết bị có động cơ khác; sản xuất các sản phẩm cơ khí, máy móc thiết bị...",
          "Ngành nghề thu hút đầu tư: Công nghiệp chế tạo và lắp ráp linh kiện cơ khí, điện tử; công nghiệp chế biến thực phẩm, hàng tiêu dùng; các ngành công nghiệp phụ trợ và các ngành công nghiệp khác có công nghệ sản xuất tiên tiến, thân thiện với môi trường; cho thuê nhà xưởng, nhà kho; hoạt động kho bãi và hỗ trợ vận tải (logistic)…",
          "Ngành nghề thu hút đầu tư: Cơ khí chế tạo, lắp ráp, ô tô, xe máy; điện, điện tử, viễn thông, công nghệ thông tin; công nghiệp phụ trợ, vật liêu mới; chế biến, bảo quản nông sản, thực phẩm, đồ uống, sữa."
        ]
      },
      "pricing": {
        "type": "thoa-thuan",
        "price": null,
        "price_min": null,
        "price_unit": null
      },
      "legal": {
        "status": "Đầy đủ giấy tờ",
        "land_use_period": ""
