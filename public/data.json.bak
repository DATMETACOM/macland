    {
      "id": "75f43aa906fe",
      "slug": "khu-cong-nghiep-yen-lu-bac-giang",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-yen-lu-bac-giang/",
      "title": "Khu Công nghiệp Yên Lư tỉnh Bắc Giang",
      "type": "khu-cong-nghiep",
      "date": "2025-07-16T15:52:19+07:00",
