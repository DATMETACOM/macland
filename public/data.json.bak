    {
      "id": "2bb4ee9596dd",
      "slug": "khu-cong-nghiep-trang-due-hai-phong",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-trang-due-hai-phong/",
      "title": "Khu Công nghiệp Tràng Duệ thành phố Hải Phòng",
      "type": "khu-cong-nghiep",
      "date": "2025-11-19T17:29:51+07:00",
      "location": {
        "province": "Hải Phòng với tổng diện tích hơn 400ha với 2 giai đoạn với tỷ lệ lấp đầy là 95",
        "district": "",
        "address": "Khu công nghiệp Tràng Duệ có là khu công nghiệp lớn và hàng đầu của Thành phố Hải Phòng với tổng diện tích hơn 400ha với 2 giai đoạn với tỷ lệ lấp đầy là 95%, được xây dựng theo quy mô quần thể kiến trúc hiện đại: Khu công nghiệp – Khu đô thị – Khu vui chơi giải trí và dịch vụ. Hiện nay, ban quản lý khu công nghiệp đang nghiên cứu để mở rộng KCN giai đoạn 3 với quy mô hơn 600ha, nằm trên địa bàn An Lão, Hải Phòng.",
        "old_address": ""
      },
      "details": {
