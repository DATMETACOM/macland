      "url": "https://www.macland.vn/bds-cong-nghiep/nha-xuong-kcn-deep-c-ii-001/",
      "title": "Cho thuê 5000m2 nhà xưởng khu công nghiệp Deep C II, Hải Phòng",
      "type": "nha-xuong",
      "date": "2025-03-20T11:11:18+07:00",
      "location": {
        "province": "",
