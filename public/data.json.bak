      "id": "e3db9815f983",
      "slug": "ban-nha-xuong-tp-hai-duong-253",
      "url": "https://www.macland.vn/bds-cong-nghiep/ban-nha-xuong-tp-hai-duong-253/",
      "title": "Cần bán nhà xưởng 36.000m2 tại Thành phố Hải Dương",
      "type": "nha-xuong",
      "date": null,
      "location": {
        "province": "Hải Dương",
