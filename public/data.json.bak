    {
      "id": "96e1f7630bb0",
      "slug": "khu-cong-nghiep-tan-trao",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-tan-trao/",
      "title": "Khu Công nghiệp Tân Trào thành phố Hải Phòng",
      "type": "khu-cong-nghiep",
      "date": "2025-10-21T17:34:53+07:00",
      "location": {
        "province": "được khởi công xây dựng hạ tầng kỹ thuật với đầy đủ tiện ích phục vụ cho nhu cầu sản xuất và cuộc sống thường nhật",
        "district": "Phú Xuyên",
        "address": "có vị trí khá đẹp, thuận lợi, nằm tại Huyện Phú Xuyên – Hà Nội, chỉ cách trung tâm thủ đô chưa đầy 1 giờ xe chạy. Là cụm công nghiệp hiện đại và là một trong số ít CCN đầu tiên của Thành phố được khởi công xây dựng hạ tầng kỹ thuật với đầy đủ tiện ích phục vụ cho nhu cầu sản xuất và cuộc sống thường nhật.",
        "old_address": ""
      },
      "details": {
        "area": "227 ha",
        "area_unit": "ha",
        "occupancy_rate": "Đang cập nhật",
        "operating_period": "",
        "investment_sectors": [
          "Công nghiệp điện, điện tử, viễn thông, dược phẩm, công nghiệp hỗ trợ, vật liệu mới, công nghiệp năng lượng sạch, năng lượng tái tạo…",
          "",
