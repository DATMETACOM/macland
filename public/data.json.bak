    {
      "id": "b169a3465d19",
      "slug": "khu-cong-nghiep-lien-ha-thai-green-ip-1-tinh-thai-binh",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghiep-lien-ha-thai-green-ip-1-tinh-thai-binh/",
      "title": "Khu Công nghiệp Liên Hà Thái tỉnh Thái Bình",
      "type": "khu-cong-nghiep",
      "date": "2025-04-25T14:22:02+07:00",
      "location": {
        "province": "",
        "district": "",
        "address": "Khu Công nghiệp Liên Hà Thái tỉnh Thái Bình",
