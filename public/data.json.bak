    {
      "id": "69fc2136dd2a",
      "slug": "cho-thue-dai-han-3500m2-nha-may-huyen-my-hao-tinh-hung-yen",
      "url": "https://www.macland.vn/bds-cong-nghiep/cho-thue-dai-han-3500m2-nha-may-huyen-my-hao-tinh-hung-yen/",
      "title": "Cho thuê dài hạn 3500m2 nhà máy huyện Mỹ Hào, tỉnh Hưng Yên",
      "type": "nha-xuong",
      "date": "2025-02-11T11:50:27+07:00",
      "location": {
        "province": "",
        "district": "",
        "address": "Cho thuê dài hạn 3500m2 nhà máy huyện Mỹ Hào, tỉnh Hưng Yên",
        "old_address": ""
      },
      "details": {
        "area": "3500 m²",
        "area_unit": "m²",
        "occupancy_rate": "Đang cập nhật",
