    {
      "id": "4dfeb2e12bae",
      "slug": "khu-cong-nghe-cao-thanh-pho-ho-chi-minh",
      "url": "https://www.macland.vn/bds-cong-nghiep/khu-cong-nghe-cao-thanh-pho-ho-chi-minh/",
      "title": "Khu Công nghệ cao thành phố Hồ Chí Minh",
      "type": "nha-xuong",
      "date": "2025-09-08T17:19:21+07:00",
      "location": {
        "province": "",
        "district": "",
        "address": "Khu Công nghệ cao thành phố Hồ Chí Minh",
        "old_address": ""
      },
      "details": {
        "area": "913 ha",
        "area_unit": "ha",
        "occupancy_rate": "99%",
