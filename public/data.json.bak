          ""
        ]
      },
      "pricing": {
        "type": "tu-usd-m2",
        "price": "105.0USD/m²",
        "price_min": 105.0,
        "price_unit": "USD/m²"
      },
      "legal": {
        "status": "Đầy đủ giấy tờ",
        "land_use_period": ""
