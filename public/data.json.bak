    {
      "id": "88c4374e60ac",
      "slug": "nha-xuong-tai-kcn-minh-duc-tinh",
      "url": "https://www.macland.vn/bds-cong-nghiep/nha-xuong-tai-kcn-minh-duc-tinh/",
      "title": "Cho thuê 5000m2 nhà xưởng tại KCN Minh Đức Hưng Yên",
      "type": "nha-xuong",
      "date": "2026-01-08T16:23:13+07:00",
      "location": {
        "province": "Nam Định khoảng 70km",
