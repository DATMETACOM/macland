			.category-page-row .is-sticky-column{
	z-index:9;
}
.product-price-container{
	margin-bottom:15px;
	font-weight: 600;
    font-size: 18px;
}
.category-page-row .large-9{
	padding-bottom:80px;
}
.devvn_readmore_flatsome a{
	width:20% !important;
	color:#a01010 !important;
	margin: 0 auto;
    border: 1px solid !important;
	padding:6px;
}
.devvn_readmore_flatsome a:after{
	border-top: 6px solid #a01010 !important;
}
.woof_sid_widget .woof_submit_search_form{
	width:100%;
	max-width:100%;
}
.accordion .toggle{
	background:none;
	color:#000;
	top:0.1em;
}
.accordion .toggle:hover{
	background:none;
	color:red;
}
.info-prod th{
	padding-left:15px !important;
}
.button, button, input[type=submit], input[type=reset], input[type=button]{
	font-weight:500 !important;
}
.price-wrapper .price{
	margin-bottom:0px;
}
.form-nhan-tin input[type='submit']{
	border: 1px solid;
}
.button.primary:not(.is-outline){
	color:#FFF !important;
}
blockquote{
	font-style:normal !important;
}
.elementor-kit-20366 a{
	color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
}
.nav-tabs > li.active > a{
	font-size:18px;
	font-weight:500;
}
.product-tabs > li,.product-tabs > li> a{
	width:100% !important;
}
.box-text.text-center{
	padding-left:18px;
	padding-right:18px;
	padding-top:20px;
}
.breadcrumbs a{
color: rgba(102, 102, 102, 1);
}
.post-sidebar{
	padding:12px !important;
	background: #f8f8f8;
}

.archive-page-header .taxonomy-description{
	margin-left:-13px;
	margin-right:-23px;
}
.blog-banner{
	margin-bottom:20px;
	margin-top:-20px;
}
.archive-page-header .page-title{
	display:none;
}
.post_comments{display:none;}
input[type=email], input[type=date], input[type=search], input[type=number], input[type=text], input[type=tel], input[type=url], input[type=password], textarea, select, .select-resize-ghost, .select2-container .select2-choice, .select2-container .select2-selection{
	box-shadow:none;
}
.wpcf7-submit{
	background-color: #a01010 !important;
    color: #FFF !important;
    width: 30%;
    border-radius: 2px;
}
.form-nhan-tin input[type='submit']{
	height:40px;
	line-height:40px;
	background-position-y:12px;
}
.wpcf7-spinner{
	display:none;
}
.wpcf7-submit{
	margin-top:15px !important;
}
.form-nhan-tin input[type="email"]{
	height:40px;
}
b,strong{font-weight:600 !important;}
.woof_sid_widget .woof_submit_search_form{
	background-color: #a01010 !important;
}
a.glink img{
	border:1px solid #FFF !important;
}
.single-post.post-template-default h1, .single-post.post-template-default h2 {
	margin-top: 15px !important;
}
.box-blog-post .is-divider{
	display:none;
}
.nav-pagination>li>span, .nav-pagination>li>a{
	margin-top:30px;
	border-radius: 2px;
    border: 1px solid #9e9e9eab;
}
.page-numbers li a{
	color:#3d3d3d !important; 
}
.widget .is-divider{
	display:none;
}
.large-3 .widget-area{
	background:#FFF !important;
}
.large-3 .widget-area, .large-3 .sidebar-inner {
    margin-bottom: 30px;
    padding: 20px;
    border-radius: 4px;
	border-top: 6px solid #a01010;
}

.product-footer .woocommerce-tabs {
    width: 1290px;
}
.about {background-color: transparent;
        background-image: linear-gradient(180deg, #ee3136 0%, #981c20 100%); border-radius:14px; margin-top:-85px;
}
.textan {
    -webkit-text-stroke-width: 1px;
    -webkit-text-stroke-color: #FFFFFF24;
    -webkit-text-fill-color: transparent;
}
.woof .widget_price_filter .ui-slider .ui-slider-range {
    background-color: #EE3136;
    border: 0 none;
    border-radius: 1em;
    display: block;
    font-size: 0.7em;
    position: absolute;
    z-index: 1;
}
.hotline-phone-ring-wrap-calendar {
    display: none;
}
.fomsp{
    margin-bottom: 30px;
    padding: 20px;
    border: 1px solid #EE3136;
    border-radius: 10px;
	box-shadow: 0 -4px 0 0 #EE3136;}
.button.icon.circle {
    color: #ee3136;
}
.mua-ngay{
		 font-size:16px
}

 .tu-van{
	font-size:16px
}
.header-main .nav > li > ul > li > a {
    font-size: 14px !important;
}		</style>
